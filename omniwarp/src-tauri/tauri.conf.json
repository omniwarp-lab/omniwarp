{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniWarp",
  "version": "0.2.0",
  "identifier": "com.amirhosseinrb.omniwarp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniWarp",
        "width": 700,
        "height": 450,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost provider-icon: http://provider-icon.localhost https://provider-icon.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;",
      "assetProtocol": { "enable": true, "scope": ["$APPCACHE/**/*"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
